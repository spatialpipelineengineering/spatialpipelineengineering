{# Colorful inline SVG icons. Usage: {{ icon("satellite", "icon") }} #}
{% macro icon(name, cls="icon") %}
{%- if name == "home" -%}
<svg class="{{ cls }}" viewBox="0 0 24 24" aria-hidden="true" fill="none">
  <path d="M3.5 11.5 12 4l8.5 7.5" stroke="#0f6e63" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
  <path d="M5.5 10v9.5h13V10" stroke="#11839e" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
  <rect x="10" y="14" width="4" height="5.5" rx="0.6" fill="#f3a712"/>
</svg>
{%- elif name == "blueprint" -%}
<svg class="{{ cls }}" viewBox="0 0 24 24" aria-hidden="true" fill="none">
  <rect x="3.5" y="4" width="17" height="16" rx="2" stroke="#11839e" stroke-width="1.8"/>
  <path d="M3.5 9h17M9 9v11" stroke="#0f6e63" stroke-width="1.6"/>
  <circle cx="14.5" cy="14.5" r="2.4" fill="none" stroke="#f3a712" stroke-width="1.8"/>
  <path d="M16.2 16.2 18 18" stroke="#f3a712" stroke-width="1.8" stroke-linecap="round"/>
</svg>
{%- elif name == "satellite" -%}
<svg class="{{ cls }}" viewBox="0 0 24 24" aria-hidden="true" fill="none">
  <rect x="9.5" y="9.5" width="5" height="5" rx="1" transform="rotate(45 12 12)" fill="#0f6e63"/>
  <rect x="3.4" y="8.4" width="4.6" height="4.6" rx="0.8" transform="rotate(45 5.7 10.7)" fill="#7fc8ff" stroke="#11839e" stroke-width="1.2"/>
  <rect x="16" y="11" width="4.6" height="4.6" rx="0.8" transform="rotate(45 18.3 13.3)" fill="#7fc8ff" stroke="#11839e" stroke-width="1.2"/>
  <path d="M14 16c1.8 1.8 1.8 3.6 1.8 3.6" stroke="#0f6e63" stroke-width="1.6" stroke-linecap="round"/>
  <circle cx="17" cy="6" r="1.6" fill="#f3a712"/>
</svg>
{%- elif name == "forest" -%}
<svg class="{{ cls }}" viewBox="0 0 24 24" aria-hidden="true" fill="none">
  <path d="M8 3.5 12.5 11h-9z" fill="#2bb673"/>
  <path d="M8 7.5 12.5 14h-9z" fill="#0f6e63"/>
  <rect x="7" y="13.5" width="2" height="6" rx="0.6" fill="#a9742f"/>
  <path d="M16.5 7 20 13h-7z" fill="#7fe0a8"/>
  <path d="M16.5 10.5 20 16h-7z" fill="#2bb673"/>
  <rect x="15.5" y="15.5" width="2" height="4" rx="0.6" fill="#a9742f"/>
</svg>
{%- elif name == "arrow-right" -%}
<svg class="{{ cls }}" viewBox="0 0 24 24" aria-hidden="true" fill="none">
  <path d="M5 12h13M13 6l6 6-6 6" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"/>
</svg>
{%- elif name == "chevron-right" -%}
<svg class="{{ cls }}" viewBox="0 0 24 24" aria-hidden="true" fill="none">
  <path d="M9 6l6 6-6 6" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"/>
</svg>
{%- elif name == "layers" -%}
<svg class="{{ cls }}" viewBox="0 0 24 24" aria-hidden="true" fill="none">
  <path d="M12 3 21 8l-9 5-9-5 9-5z" fill="#11839e"/>
  <path d="M3 12.5 12 17.5 21 12.5" stroke="#2bb673" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
  <path d="M3 16.5 12 21.5 21 16.5" stroke="#f3a712" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
</svg>
{%- elif name == "menu" -%}
<svg class="{{ cls }}" viewBox="0 0 24 24" aria-hidden="true" fill="none">
  <path d="M4 7h16M4 12h16M4 17h16" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
</svg>
{%- elif name == "close" -%}
<svg class="{{ cls }}" viewBox="0 0 24 24" aria-hidden="true" fill="none">
  <path d="M6 6l12 12M18 6 6 18" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
</svg>
{%- elif name == "copy" -%}
<svg class="{{ cls }}" viewBox="0 0 24 24" aria-hidden="true" fill="none">
  <rect x="9" y="9" width="11" height="11" rx="2" stroke="currentColor" stroke-width="1.8"/>
  <path d="M5 15V5a2 2 0 0 1 2-2h10" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
</svg>
{%- elif name == "check" -%}
<svg class="{{ cls }}" viewBox="0 0 24 24" aria-hidden="true" fill="none">
  <path d="M5 12.5 10 17.5 19 7" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
</svg>
{%- elif name == "workflow" -%}
<svg class="{{ cls }}" viewBox="0 0 24 24" aria-hidden="true" fill="none">
  <rect x="3" y="4" width="6" height="5" rx="1.2" fill="#7fc8ff" stroke="#11839e" stroke-width="1.3"/>
  <rect x="15" y="15" width="6" height="5" rx="1.2" fill="#7fe0a8" stroke="#0f6e63" stroke-width="1.3"/>
  <path d="M9 6.5h4a2 2 0 0 1 2 2V15" stroke="#0f6e63" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/>
  <circle cx="6" cy="17.5" r="2.4" fill="none" stroke="#f3a712" stroke-width="1.7"/>
  <path d="M6 9v5.6" stroke="#f3a712" stroke-width="1.7" stroke-linecap="round"/>
</svg>
{%- elif name == "github" -%}
<svg class="{{ cls }}" viewBox="0 0 24 24" aria-hidden="true" fill="none">
  <path fill="currentColor" fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.48 2 2 6.58 2 12.25c0 4.53 2.87 8.37 6.84 9.73.5.1.68-.22.68-.49 0-.24-.01-.88-.01-1.73-2.78.62-3.37-1.22-3.37-1.22-.46-1.18-1.11-1.5-1.11-1.5-.9-.63.07-.62.07-.62 1 .07 1.53 1.05 1.53 1.05.89 1.56 2.34 1.11 2.91.85.09-.66.35-1.11.63-1.37-2.22-.26-4.55-1.14-4.55-5.06 0-1.12.39-2.03 1.03-2.75-.1-.26-.45-1.3.1-2.71 0 0 .84-.28 2.75 1.05a9.36 9.36 0 0 1 5 0c1.91-1.33 2.75-1.05 2.75-1.05.55 1.41.2 2.45.1 2.71.64.72 1.03 1.63 1.03 2.75 0 3.93-2.34 4.8-4.57 5.05.36.32.68.94.68 1.9 0 1.37-.01 2.47-.01 2.81 0 .27.18.6.69.49A10.02 10.02 0 0 0 22 12.25C22 6.58 17.52 2 12 2Z"/>
</svg>
{%- endif -%}
{% endmacro %}

{% from "icons.njk" import icon %}
{%- set categories = collections.content | childrenOf("/") -%}
{%- set pageTitle = title if title else site.title -%}
{%- set titleShort = shortTitle if shortTitle else pageTitle -%}
{%- set metaDesc = description if description else site.metaDescription -%}
{%- set canonical = site.url + page.url -%}
<!doctype html>
<html lang="{{ site.lang }}">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{{ titleShort }} | SPE</title>
    <meta name="description" content="{{ metaDesc }}" />
    <link rel="canonical" href="{{ canonical }}" />

    <meta name="theme-color" content="{{ site.themeColor }}" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0c1512" media="(prefers-color-scheme: dark)" />
    <meta name="color-scheme" content="light dark" />
    <meta name="robots" content="index, follow, max-image-preview:large" />

    <!-- Open Graph / Twitter -->
    <meta property="og:type" content="{% if page.url == '/' %}website{% else %}article{% endif %}" />
    <meta property="og:site_name" content="{{ site.name }}" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:title" content="{{ pageTitle }}" />
    <meta property="og:description" content="{{ metaDesc }}" />
    <meta property="og:url" content="{{ canonical }}" />
    <meta property="og:image" content="{{ site.url }}/og-image.png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="{{ site.name }} — MRV Automation social card" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="{{ pageTitle }}" />
    <meta name="twitter:description" content="{{ metaDesc }}" />
    <meta name="twitter:image" content="{{ site.url }}/og-image.png" />

    <!-- Icons & PWA -->
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="default" />
    <meta name="apple-mobile-web-app-title" content="{{ site.name }}" />
    <meta name="application-name" content="{{ site.name }}" />

    <!-- Stamp the stored choice before first paint so a dark-mode reader never
         gets a white flash. With no stored choice the attribute stays off and
         the stylesheet's prefers-color-scheme rules follow the OS. -->
    <script>
      (function () {
        try {
          var t = localStorage.getItem("spe-theme");
          if (t === "dark" || t === "light") document.documentElement.setAttribute("data-theme", t);
        } catch (e) {}
      })();
    </script>
    <link rel="stylesheet" href="/assets/css/style.css?v={{ assets.v }}" />
    {% if hasMath %}<link rel="stylesheet" href="/assets/vendor/katex/katex.min.css" />{% endif %}

    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "WebSite",
        "name": "{{ site.name }}",
        "alternateName": "{{ site.title }}",
        "url": "{{ site.url }}",
        "inLanguage": "{{ site.lang }}",
        "description": "{{ site.metaDescription }}",
        "publisher": {
          "@type": "Organization",
          "name": "{{ site.name }}",
          "url": "{{ site.url }}",
          "logo": {
            "@type": "ImageObject",
            "url": "{{ site.url }}/assets/img/icon-512.png",
            "width": 512,
            "height": 512
          }
        }
      }
    </script>
    {% block head %}{% endblock %}
    <script src="/assets/js/app.js?v={{ assets.v }}" defer></script>
  </head>
  <body{% if hasMath %} data-math="true"{% endif %}{% if hasMermaid %} data-mermaid="true"{% endif %}>
    <a class="skip-link" href="#main">Skip to content</a>

    <header class="site-header">
      <div class="container site-header__inner">
        <a class="brand" href="{{ site.url }}/" aria-label="{{ site.name }} — home">
          <img class="brand__logo" src="/assets/img/logo.svg" width="38" height="38" alt="" />
          <span class="brand__name">{{ site.name }}<small>MRV Automation</small></span>
        </a>

        <button class="theme-toggle" type="button" data-theme-toggle aria-label="Switch to dark theme" title="Switch colour theme">
          {{ icon("sun") }}{{ icon("moon") }}
        </button>

        <button class="nav-toggle" aria-controls="primary-nav" aria-expanded="false" aria-label="Toggle navigation">
          {{ icon("menu") }}
        </button>

        <nav class="nav" id="primary-nav" aria-label="Primary">
          <a class="nav__link" href="{{ site.url }}/"{% if page.url == "/" %} aria-current="page"{% endif %}>
            {{ icon("home") }}<span>Home</span>
          </a>
          {%- for cat in categories -%}
            {%- set slug = cat.url | topSlug -%}
            {%- set meta = site.sections[slug] -%}
            <a class="nav__link" href="{{ site.url }}{{ cat.url }}"{% if page.url | startsWith(cat.url) %} aria-current="page"{% endif %}>
              {{ icon(meta.icon if meta else "layers") }}<span>{{ meta.label if meta else cat.data.title }}</span>
            </a>
          {%- endfor -%}
        </nav>
      </div>
    </header>

    <main class="site-main" id="main">
      {{ content | safe }}
    </main>

    <footer class="site-footer">
      <div class="container site-footer__inner">
        <div>
          <span class="site-footer__brand">
            <img src="/assets/img/logo.svg" width="34" height="34" alt="" />
            {{ site.name }}
          </span>
          <p class="site-footer__tag">{{ site.description }}</p>
        </div>
        <nav class="footer-nav" aria-label="Footer">
          <h2>Sections</h2>
          <ul>
            <li><a href="{{ site.url }}/">{{ icon("home") }}<span>Home</span></a></li>
            {%- for cat in categories -%}
              {%- set slug = cat.url | topSlug -%}
              {%- set meta = site.sections[slug] -%}
              <li><a href="{{ site.url }}{{ cat.url }}">{{ icon(meta.icon if meta else "layers") }}<span>{{ meta.label if meta else cat.data.title }}</span></a></li>
            {%- endfor -%}
          </ul>
        </nav>
      </div>
      <div class="container site-footer__bottom">
        <p>{{ site.title }} — MRV Automation. Built for ESG engineers, climate data scientists, and Python GIS teams.</p>
        <a class="site-footer__social" href="https://github.com/spatialpipelineengineering" rel="noopener" aria-label="{{ site.name }} on GitHub">
          {{ icon("github") }}<span>GitHub</span>
        </a>
      </div>
    </footer>
  </body>
</html>
